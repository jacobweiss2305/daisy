{
  "name": "daisy",
  "displayName": "Daisy",
  "description": "A coding agent that fetches. Runs on a local model, reads and writes your workspace, and runs commands.",
  "version": "0.1.0",
  "license": "MIT",
  "publisher": "jacobweiss2305",
  "repository": {
    "type": "git",
    "url": "https://github.com/jacobweiss2305/daisy.git"
  },
  "engines": {
    "vscode": "^1.106.0"
  },
  "categories": [
    "AI"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "secondarySidebar": [
        {
          "id": "daisy",
          "title": "Daisy",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "daisy": [
        {
          "id": "daisy.chat",
          "name": "Chat",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "Daisy",
      "properties": {
        "daisy.endpoints": {
          "type": "array",
          "default": [
            {
              "name": "ollama",
              "baseUrl": "http://localhost:11434/v1",
              "apiKey": ""
            }
          ],
          "items": {
            "type": "object",
            "properties": {
              "name": {
                "type": "string",
                "description": "Label shown in the dropdown."
              },
              "baseUrl": {
                "type": "string",
                "description": "OpenAI-compatible base URL."
              },
              "apiKey": {
                "type": "string",
                "description": "Bearer token. Empty for local servers."
              }
            },
            "required": [
              "name",
              "baseUrl"
            ]
          },
          "markdownDescription": "Servers to offer in the model dropdown. Every reachable one is listed together."
        },
        "daisy.endpoint": {
          "type": "string",
          "default": "",
          "description": "Name of the endpoint serving the selected model. Set by the dropdown."
        },
        "daisy.model": {
          "type": "string",
          "default": "hf.co/unsloth/Qwen3.8-27B-GGUF:UD-Q4_K_XL",
          "description": "Model identifier passed to the endpoint."
        },
        "daisy.maxSteps": {
          "type": "integer",
          "default": 12,
          "minimum": 1,
          "description": "Maximum tool round trips per message."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "vscode:prepublish": "npm run build",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"src/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/vscode": "^1.106.0",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2"
  }
}
