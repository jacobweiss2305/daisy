{
  "name": "vscode-local-agent",
  "displayName": "Local Agent",
  "description": "Chat sidebar backed by any OpenAI-compatible model, with workspace file and shell tools.",
  "version": "0.1.0",
  "license": "MIT",
  "publisher": "jacobweiss2305",
  "repository": {
    "type": "git",
    "url": "https://github.com/jacobweiss2305/vscode-local-agent.git"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "AI"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "localAgent",
          "title": "Local Agent",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "localAgent": [
        {
          "id": "localAgent.chat",
          "name": "Chat",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "Local Agent",
      "properties": {
        "localAgent.baseUrl": {
          "type": "string",
          "default": "http://localhost:11434/v1",
          "markdownDescription": "OpenAI-compatible base URL. Ollama, llama.cpp, LM Studio, vLLM, and hosted providers all work."
        },
        "localAgent.model": {
          "type": "string",
          "default": "hf.co/unsloth/Qwen3.8-27B-GGUF:UD-Q4_K_XL",
          "description": "Model identifier passed to the endpoint."
        },
        "localAgent.apiKey": {
          "type": "string",
          "default": "",
          "description": "Bearer token. Leave empty for local servers."
        },
        "localAgent.maxSteps": {
          "type": "integer",
          "default": 12,
          "minimum": 1,
          "description": "Maximum tool round trips per message."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "vscode:prepublish": "npm run build",
    "test": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"src/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/vscode": "^1.95.0",
    "esbuild": "^0.24.2",
    "typescript": "^5.7.2"
  }
}
